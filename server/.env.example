# Copy to .env and edit. The server loads .env automatically (Node >= 20.12).
# NEVER commit a real .env, and never ship private keys inside the mobile app.

PORT=4000

# "mock": no Arkose account needed. The server fabricates Verify API v4 responses
#         from tokens shaped like  mock.<scenario>.<nonce>  (see docs/DEMO_SCRIPT.md).
# "live": tokens are verified against the real Arkose Verify API v4.
ARKOSE_MODE=mock

# --- Live mode only -------------------------------------------------------
# Verify API endpoint. Use your company-specific host once Arkose provisions it:
#   https://<company>-verify.arkoselabs.com/api/v4/verify/
ARKOSE_VERIFY_URL=https://verify-api.arkoselabs.com/api/v4/verify/

# Base URL the web client script and the native SDK load from (SDK `apiBaseUrl`).
# Replace with your vanity URL if Arkose provided one.
ARKOSE_CLIENT_API_BASE_URL=https://client-api.arkoselabs.com/v2

# One key pair for everything...
ARKOSE_PUBLIC_KEY=YOUR_PUBLIC_KEY
ARKOSE_PRIVATE_KEY=YOUR_PRIVATE_KEY

# ...or a separate pair per protected flow (recommended in production so each
# flow gets its own risk settings and reporting). Per-flow values win.
# ARKOSE_PUBLIC_KEY_SEARCH=
# ARKOSE_PRIVATE_KEY_SEARCH=
# ARKOSE_PUBLIC_KEY_SIGNUP=
# ARKOSE_PRIVATE_KEY_SIGNUP=
# ARKOSE_PUBLIC_KEY_LOGIN=
# ARKOSE_PRIVATE_KEY_LOGIN=
# ARKOSE_PUBLIC_KEY_CHECKOUT=
# ARKOSE_PRIVATE_KEY_CHECKOUT=

# Verify API call timeout (ms). Exceeding it triggers the per-flow fail mode.
ARKOSE_VERIFY_TIMEOUT_MS=4000

# --- Demo behaviour -------------------------------------------------------
# Include the raw Verify API response in API replies so the in-app debug panel can
# show it. Defaults to true in mock mode and false in live mode. Keep it OFF in
# production: the raw response is internal risk intelligence.
# DEMO_DEBUG=true

# Stand-in second factor used when the policy returns "step_up". A real system would
# send a one-time code by SMS/email/push and verify it with that provider.
DEMO_STEPUP_CODE=000000

# Signing secret for the demo session tokens. If unset, a random one is generated
# at startup (sessions are lost on restart).
# AUTH_SECRET=change-me
